    "check:owners": "node scripts/check-owners.mjs",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "e2e:chapters": "node scripts/e2e-chapters.mjs",
    "e2e:perf": "node scripts/e2e-perf.mjs",
    "e2e:visual": "node scripts/e2e-visual.mjs",
    "e2e:touch": "node tests/e2e-touch.mjs",
